# Copy to .env (gitignored) and fill in. Read by the data tools (npm run prefill…), never by the app:
# Vite only exposes VITE_* variables to the browser, so don't prefix secrets with VITE_.

# Copernicus Climate Data Store personal access token (https://cds.climate.copernicus.eu/profile).
# Used by the UTCI prefill. Accept each dataset's licence on its Download tab first.
CDSAPI_KEY=
