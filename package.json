{
  "name": "mapstats",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "imports": {
    "#core/*": "./src/core/*",
    "#providers/*": "./src/providers/*",
    "#sdk": "./tools/sdk/index.mjs",
    "#sdk/*": "./tools/sdk/*"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "geo": "node scripts/build-geo.mjs",
    "lint": "eslint .",
    "snic:import": "node tools/cli/prefill.mjs ARG --provider snic",
    "news:test": "node netlify/news/test/run.mjs",
    "news:probe": "node scripts/news-probe.mjs",
    "live:test": "node src/lib/test/live.mjs",
    "golden": "node tests/golden.mjs",
    "test": "node tools/cli/test.mjs",
    "deploy": "npm run lint && npm test && npx -y -p netlify-cli netlify deploy --prod",
    "deploy:preview": "npx -y -p netlify-cli netlify deploy",
    "dev:netlify": "npx -y -p netlify-cli netlify dev",
    "prefill": "node tools/cli/prefill.mjs",
    "country:check": "node tools/cli/country-check.mjs",
    "country:new": "node tools/cli/country-new.mjs",
    "prefill:due": "node tools/cli/prefill-due.mjs",
    "anchors": "node tools/cli/anchors.mjs"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@netlify/blobs": "^10.7.13",
    "chart.js": "^4.5.1",
    "fast-xml-parser": "^5.11.2",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "linkedom": "^0.18.13",
    "lucide-react": "^1.49.0",
    "maplibre-gl": "^6.11.2",
    "react": "^19.3.0",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@vitejs/plugin-react": "^6.1.1",
    "cheerio": "^1.2.0",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "exceljs": "^4.4.0",
    "fflate": "0.8.3",
    "geotiff": "^3.0.5",
    "globals": "^17.13.0",
    "h5wasm": "0.10.3",
    "mapshaper": "^0.7.72",
    "vite": "^8.3.2"
  }
}
